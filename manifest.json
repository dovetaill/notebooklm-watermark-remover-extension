{
  "manifest_version": 3,
  "name": "NotebookLM Watermark Cleaner",
  "description": "Extract NotebookLM rendered slides, clean watermark, and export as ZIP.",
  "version": "0.6.1",
  "permissions": ["downloads", "activeTab"],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://lh3.googleusercontent.com/*",
    "https://lh3.google.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "NotebookLM Cleaner",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["shared/transport_codec.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/notebooklm_watermark_transparent.png",
        "assets/userscript_core.wasm"
      ],
      "matches": ["https://notebooklm.google.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
